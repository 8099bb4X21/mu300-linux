#!/bin/sh
# own: IPv6 安卓对齐的 uci 默认值（95-own-defaults 同机制）。
# 在 kano 90-mu300 之后执行（编号 96），覆盖它写死的 relay/NAT66。
# 只在全新安装首启生效一次（marker 见末尾；sysupgrade 保留配置的用户改动不再覆盖）。
# 由 custom/net-v6-hotfix.sh 容器期安装；上游默认改对后随 hotfix 整块删除。
[ "$(uci -q get system.net_v6_hotfix.enabled)" = 1 ] && exit 0

uci -q batch <<UCI
set dhcp.lan.ra='server'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ndp='disabled'
set dhcp.lan.ra_slaac='1'
set dhcp.lan.ra_lifetime='3600'
set dhcp.lan.ra_preference='high'
set dhcp.lan.ra_mtu='1500'
set dhcp.lan.ra_dns='1'
set dhcp.lan.ra_default='1'
delete dhcp.lan.ra_flags
set dhcp.wan.ra='disabled'
set dhcp.wan.dhcpv6='disabled'
delete dhcp.wan.master
UCI
# 注：dhcp.wan.ndp 故意不动（保持 90-mu300 的 relay，与 10-07/10-12 两次
# 线上验证状态一致；wan 侧 ra 已关，该键无实际作用）。

# firewall wan zone 去 masq6（按名查找，不写死 @zone[序号]，仿 90-mu300 手法）：
zone=$(uci -q show firewall | sed -n "s/^\(firewall\.@zone\[[0-9]*\]\)\.name='wan'$/\1/p")
[ -n "$zone" ] || exit 1
uci -q delete "$zone".masq6 2>/dev/null || true

uci commit dhcp
uci commit firewall

# 断言（失败则本文件留待下次开机重试，不写 marker）：
[ "$(uci -q get dhcp.lan.ra)" = server ] || exit 1
[ "$(uci -q get dhcp.wan.ra)" = disabled ] || exit 1
uci -q get "$zone".masq6 >/dev/null 2>&1 && exit 1

uci -q batch <<UCI
set system.net_v6_hotfix=net_v6_hotfix
set system.net_v6_hotfix.enabled='1'
UCI
uci commit system
exit 0
