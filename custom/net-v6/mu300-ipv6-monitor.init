#!/bin/sh /etc/rc.common
# mu300-ipv6-monitor: IPv6 断线监控,断线重拨,重拨无效则重启(30 分钟冷却)
# 安装: 复制脚本到 /usr/sbin/mu300-ipv6-monitor,本文件到 /etc/init.d/,
#       chmod +x 两者, /etc/init.d/mu300-ipv6-monitor enable

USE_PROCD=1
START=99

start_service() {
    procd_open_instance mu300-ipv6-monitor
    procd_set_param command /usr/sbin/mu300-ipv6-monitor
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
