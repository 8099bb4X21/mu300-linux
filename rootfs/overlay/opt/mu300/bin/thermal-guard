#!/bin/sh
# Thermal safety for kernels without functional CPU cooling bindings. The mainline virtual sensor, when
# available, restores the stock DT trips and lets native cooling handle frequency limits. Otherwise above HOT
# caps each policy one step lower, below COOL lifts the cap. Mainline keeps CRIT emergency shutdown either way.
# The 5.4 vendor kernel throttles/protects itself, so there this script only watches.
# On every kernel: the SoC at HOT or (U30 Air) the battery at BATT_HOT (tenths of a degree, as power_supply reports it) sets
# off the LED alarm (mu300-led alarm: a red and blue siren), until the SoC is down to COOL and the battery to
# BATT_COOL.
HOT=${MU300_THERMAL_HOT:-85000}
COOL=${MU300_THERMAL_COOL:-75000}
CRIT=${MU300_THERMAL_CRIT:-105000}
BATT_HOT=${MU300_BATTERY_HOT:-500}
BATT_COOL=${MU300_BATTERY_COOL:-450}
R=${MU300_SYSROOT:-}   # (for tests/: a fake /, one round)
LED=${MU300_BIN:-/opt/mu300/bin}/mu300-led

throttle=1
for z in "$R"/sys/class/thermal/thermal_zone*; do
    [ -e "$z/trip_point_0_temp" ] && { throttle=0; echo "kernel thermal trips present: only the LED alarm here"; break; }
done
legacy_throttle=$throttle
[ -d "$R/sys/module/mu300_thermal" ] && legacy_throttle=1

# The mainline virtual sensor can probe after this service starts. Only hand
# frequency control over when every existing CPU cooling device is bound to
# the enabled stock zone. Keep our more conservative 105 C shutdown protection.
native_cpu_cooling() {
    local zone mode kind dev link found count=0
    [ -d "$R/sys/module/mu300_thermal" ] || return 1
    for zone in "$R"/sys/class/thermal/thermal_zone*; do
        read -r kind < "$zone/type" 2>/dev/null || continue
        [ "$kind" = soc-thmzone ] || continue
        read -r mode < "$zone/mode" 2>/dev/null || continue
        [ "$mode" = enabled ] || return 1
        for dev in "$R"/sys/class/thermal/cooling_device*; do
            read -r kind < "$dev/type" 2>/dev/null || continue
            case "$kind" in cpufreq-*) ;; *) continue ;; esac
            count=$((count + 1)); found=0
            for link in "$zone"/cdev[0-9]*; do
                [ "$link" -ef "$dev" ] && { found=1; break; }
            done
            [ "$found" = 1 ] || return 1
        done
        [ "$count" -gt 0 ] && return 0
    done
    return 1
}

hottest() {
    local max=0 t
    for z in "$R"/sys/class/thermal/thermal_zone*/temp; do
        read -r t < "$z" 2>/dev/null || continue
        [ "$t" -gt "$max" ] 2>/dev/null && max=$t
    done
    echo "$max"
}
DEVICE=$(${MU300_BIN:-/opt/mu300/bin}/mu300-device)
battery() {  # the battery's temperature in tenths of a degree; the U30 Air only
    local b t
    # The F50 has no battery, but under mainline the PMIC's fuel gauge probes on it too and reports one, at a
    # temperature read from an unconnected NTC input (750: 75 C): the alarm went on at every boot and never off.
    [ "$DEVICE" = u30air ] || return 0
    for b in "$R"/sys/class/power_supply/*; do
        [ "$(cat "$b/type" 2>/dev/null)" = Battery ] || continue
        read -r t < "$b/temp" 2>/dev/null && [ -n "$t" ] && { echo "$t"; return; }
    done
}

# step POLICY DIR (-1 lower, +1 higher): move scaling_max_freq to the neighbouring available frequency
step() {
    local p=$1 dir=$2 cur prev= f next=
    read -r cur < "$p/scaling_max_freq"
    for f in $(tr ' ' '\n' < "$p/scaling_available_frequencies" | sort -n); do
        if [ "$dir" -lt 0 ]; then
            [ "$f" -lt "$cur" ] && next=$f
        elif [ -z "$next" ] && [ "$f" -gt "$cur" ]; then
            next=$f
        fi
    done
    [ -n "$next" ] && echo "$next" > "$p/scaling_max_freq"
}

# the alarm's state outlives a restart of this service, so a cooled device is never left flashing
ALARM=$R/run/mu300/thermal-alarm
while :; do
    throttle=$legacy_throttle
    emergency=$legacy_throttle
    if [ -d "$R/sys/module/mu300_thermal" ]; then
        throttle=1; emergency=1
        native_cpu_cooling && throttle=0
    fi
    t=$(hottest)
    b=$(battery)
    if [ "$t" -ge "$CRIT" ] && [ "$emergency" = 1 ]; then
        logger -t thermal-guard "critical temperature ${t} mC, powering off"
        poweroff
    elif [ "$t" -ge "$HOT" ] && [ "$throttle" = 1 ]; then
        for p in "$R"/sys/devices/system/cpu/cpufreq/policy*; do step "$p" -1; done
        logger -t thermal-guard "hot (${t} mC): lowered cpufreq limits"
    elif [ "$t" -le "$COOL" ] && [ "$throttle" = 1 ]; then
        for p in "$R"/sys/devices/system/cpu/cpufreq/policy*; do
            [ "$(cat $p/scaling_max_freq)" -lt "$(cat $p/cpuinfo_max_freq)" ] && step "$p" 1
        done
    fi
    if [ ! -e "$ALARM" ] && { [ "$t" -ge "$HOT" ] || [ "${b:-0}" -ge "$BATT_HOT" ]; }; then
        mkdir -p "${ALARM%/*}" && : > "$ALARM"
        logger -t thermal-guard "too hot (SoC ${t} mC, battery ${b:--} dC): LED alarm on"
        "$LED" alarm on
    elif [ -e "$ALARM" ] && [ "$t" -le "$COOL" ] && [ "${b:-0}" -le "$BATT_COOL" ]; then
        rm -f "$ALARM"
        logger -t thermal-guard "cooled down (SoC ${t} mC, battery ${b:--} dC): LED alarm off"
        "$LED" alarm off
    fi
    [ -n "$R" ] && exit 0
    sleep 5
done
