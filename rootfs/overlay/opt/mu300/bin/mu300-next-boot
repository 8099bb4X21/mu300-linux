#!/bin/bash
# Choose what the MU300 boots next, detecting the A/B layout at runtime.
#   mu300-next-boot linux          Linux stays the default (re-armed on every successful boot)
#   mu300-next-boot android        next reboot (and later ones) go to Android
#   mu300-next-boot attempts [N]   show, or set, how many boots may fail before Android (1-6)
#   mu300-next-boot --rearm        used by mu300-boot-ok.service after a successful boot
#   mu300-next-boot status
#
# The Linux slot is detected from the boot cmdline (androidboot.slot_suffix) or
# the misc bootloader_control; Android is always on the other one. The
# bootloader_control block is built dynamically - no pre-baked .bin templates,
# no hardcoded slot letters. Works on any A/B layout.
export PATH="$PATH:/opt/mu300/busybox-bin"
set -eu
CONF=/etc/mu300/default-boot
MISC=$(cat /run/mu300/misc-dev 2>/dev/null || readlink -f /dev/block/by-name/misc)
DEFAULT_ATTEMPTS=5

disk_dir() {
    for d in /mnt/mu300-disk ""; do [ -d "$d/.mu300" ] && { printf '%s/.mu300' "$d"; return; }; done
    return 1
}

attempts() {
    n=$(cat "$(disk_dir)/boot-attempts" 2>/dev/null || true)
    case $n in [1-6]) echo "$n" ;; *) echo "$DEFAULT_ATTEMPTS" ;; esac
}

hex_of_file() { od -An -tx1 -v "$1" | tr -d ' \n'; }
hex_of_misc() { dd if="$MISC" bs=1 skip=2048 count=32 2>/dev/null | od -An -tx1 -v | tr -d ' \n'; }
bytes_of() { printf "$(printf '%s' "$1" | sed 's/../\\x&/g')"; }

# ---- slot detection ----------------------------------------------------------
# Which slot did we boot from? cmdline first, misc block as fallback.
this_slot() {
    local s
    s=$(grep -o 'slot_suffix=_[ab]' /proc/cmdline 2>/dev/null | head -1 | cut -d= -f2 | tr -d _)
    if [ -n "$s" ]; then echo "$s"; return; fi
    local hex
    hex=$(dd if="$MISC" bs=1 skip=2048 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')
    case "$hex" in
        5f61) echo a ;;
        5f62) echo b ;;
        *)    echo b ;;   # common layout when nothing is readable
    esac
}
other_slot() { [ "$1" = a ] && echo b || echo a; }

# ---- dynamic block builder ----------------------------------------------------
# Build a bootloader_control block that arms TARGET for one boot, from the
# current live misc block (preserves the magic/header bytes we don't touch).
#   TARGET = a or b, TRIES = boot attempts before rollback
# Output: 64-char hex on stdout.
make_block() {  # make_block TARGET TRIES
    local target=$1 tries=$2 live
    live=$(hex_of_misc)
    [ ${#live} = 64 ] || return 1
    # refuse to build from a non-BCAB block (corrupted/erased misc)
    [ "$(printf '%s' "$live" | cut -c9-16)" = "42434142" ] || return 1

    # armed: priority 15, tries=N, successful 0;  idle: priority 14, tries 1, successful 1
    local armed=$(( 0x0f | (tries << 4) ))
    local idle=$(( 0x0e | (1 << 4) | (1 << 7) ))
    local tchar;  [ "$target" = a ] && tchar=61 || tchar=62   # 'a' or 'b' in hex

    # CRC-32 (the same one gzip uses, so we can compute it with gzip itself)
    local body="${live:0:2}${tchar}${live:4:22}"          # slot_suffix at bytes 0-1
    if [ "$target" = a ]; then
        body="${body:0:24}$(printf '%02x' $armed)${body:26:2}$(printf '%02x' $idle)${body:30:26}"
    else
        body="${body:0:24}$(printf '%02x' $idle)${body:26:2}$(printf '%02x' $armed)${body:30:26}"
    fi
    local crc
    crc=$(bytes_of "$body" | gzip -c | tail -c 8 | head -c 4 | od -An -tx1 -v | tr -d ' \n')
    [ ${#crc} = 8 ] || return 1
    printf '%s%s' "$body" "$crc"
}

write_block() {  # write_block HEX
    local tmp; tmp=$(mktemp)
    bytes_of "$1" > "$tmp"
    dd if="$tmp" of="$MISC" bs=1 seek=2048 conv=notrunc 2>/dev/null
    sync; rm -f "$tmp"
    [ "$(hex_of_misc)" = "$1" ] || { echo "misc verify failed" >&2; exit 1; }
}

arm_linux() {
    local n; n=$(attempts)
    local slot; slot=$(this_slot)
    local block; block=$(make_block "$slot" $((n + 1)))
    [ ${#block} = 64 ] || { echo "cannot build the $slot block; arming with 2 tries" >&2
                            block=$(make_block "$slot" 2); }
    write_block "$block"
    echo "slot $slot armed: $n failed boot(s) before Android (slot $(other_slot $slot))"
}

arm_android() {
    local slot; slot=$(other_slot "$(this_slot)")
    local block; block=$(make_block "$slot" 2)
    [ ${#block} = 64 ] || { echo "cannot build the $slot block" >&2; exit 1; }
    write_block "$block"
    echo "next boot: Android (slot $slot)"
}

clear_boot_tries() {
    d=$(disk_dir) || return 0
    echo 0 > "$d/boot-tries" 2>/dev/null && sync
}

slot_state() {
    b=$(hex_of_misc)
    local cur; cur=$(this_slot)
    echo "misc bootloader_control: $b"
    echo "  this system: slot $cur (Linux)  ·  other: slot $(other_slot $cur) (Android)"
    echo "  slot a info: ${b:24:2}  slot b info: ${b:28:2}  (prio | tries<<4 | successful<<7)"
}

case "${1:-status}" in
    linux)   mkdir -p /etc/mu300; echo linux > "$CONF"; arm_linux; echo "default boot: linux" ;;
    android) mkdir -p /etc/mu300; echo android > "$CONF"; arm_android ;;
    attempts)
        if [ -z "${2:-}" ]; then attempts; exit 0; fi
        case $2 in [1-6]) ;; *) echo "attempts must be 1-6" >&2; exit 2 ;; esac
        d=$(disk_dir) || { echo "cannot find the MU300 disk area" >&2; exit 1; }
        echo "$2" > "$d/boot-attempts.tmp" && mv "$d/boot-attempts.tmp" "$d/boot-attempts" && sync
        [ "$(cat "$CONF" 2>/dev/null)" = linux ] && arm_linux || echo "saved; used once Linux is the default boot" ;;
    --rearm) clear_boot_tries
             [ "$(cat "$CONF" 2>/dev/null)" = linux ] && arm_linux || echo "default boot is not linux, nothing to do" ;;
    status)  echo "default boot: $(cat "$CONF" 2>/dev/null || echo android)"
             echo "failed boots before Android: $(attempts)"
             d=$(disk_dir) && [ -f "$d/boot-tries" ] && echo "boots since the last good one: $(cat "$d/boot-tries")"
             slot_state ;;
    *) echo "usage: $0 linux|android|attempts [N]|status" >&2; exit 2 ;;
esac
