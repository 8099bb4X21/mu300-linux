[Unit]
# the vendor modem loader exists only in the 5.4 kernel
# the modem driver, not its device node: the driver is loaded in the initramfs on both kernels, but the node
# appears later on mainline (+18 s, after sysinit), and a condition checked before that dropped these units
ConditionPathExists=|/sys/module/sprd_modem_loader
ConditionPathExists=|/dev/modem
ConditionPathExists=|/dev/pmsys
Description=MU300 mobile data (AT + sipa_eth0) with NAT for USB/Wi-Fi clients
After=mu300-vendor.service mu300-atd.service mu300-usb-net.service systemd-resolved.service
Wants=mu300-vendor.service mu300-atd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# a short settle only: radio_on itself waits for the AT channel to answer (up to MU300_CFUN_WAIT=30 s)
# before touching the modem, which is what the old flat 15 s sleep was really waiting for (V50 开机提速
# 研究的实测：AT 口第一次回话是 +CFUN: 0，等回话比等固定秒数又快又准)
# APN and PDP type, if the carrier needs them set; absent is fine (the leading - makes it optional)
EnvironmentFile=-/etc/mu300/mobile-data.conf
ExecStartPre=/bin/sleep 5
ExecStart=/opt/mu300/bin/mobile-data up
ExecStop=/opt/mu300/bin/mobile-data down
# tearing the data call down talks to the modem; a reboot must not wait for that
TimeoutStopSec=15
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
