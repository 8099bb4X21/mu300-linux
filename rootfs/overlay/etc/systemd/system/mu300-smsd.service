[Unit]
Description=MU300 SMS pool keeper (see /opt/mu300/bin/mu300-sms)
# the SIPC tty only exists once the vendor modem stack is up
ConditionPathExists=|/dev/stty_nr1
After=mu300-atd.service
Wants=mu300-atd.service
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/mu300/bin/mu300-smsd
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
