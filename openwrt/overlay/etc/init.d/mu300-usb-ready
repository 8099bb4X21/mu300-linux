#!/bin/sh /etc/rc.common
# Keep the management address alive until netifd adopts usb0 into br-lan.
# The gadget was already bound in initramfs and the host already has (or is
# requesting) its lease. Never create a fake cable event in normal boot.
START=51
STOP=01

start() {
	/opt/mu300/bin/busybox ifconfig usb0 192.168.77.1 netmask 255.255.255.0 up
}

stop() {
	# Give the host a clean disconnect on a warm reboot. The next initramfs bind
	# is then the only enumeration event of the next boot, just like power-on.
	c=/sys/kernel/config
	mkdir -p "$c"
	grep -q " $c configfs" /proc/mounts || mount -t configfs configfs "$c" 2>/dev/null || return 0
	g=$c/usb_gadget/linux
	udc=$(cat "$g/UDC" 2>/dev/null)
	[ -n "$udc" ] && echo "" > "$g/UDC"
	# A configfs unbind alone leaves this Unisoc DWC3 controller's NCM TX
	# endpoint wedged across some warm resets (RX and carrier remain alive).
	# Unbind the controller only during shutdown; the next kernel probes it
	# afresh before initramfs binds the gadget, so boot still enumerates once.
	[ -n "$udc" ] && [ -e /sys/bus/platform/drivers/dwc3-unisoc/unbind ] &&
		echo "$udc" > /sys/bus/platform/drivers/dwc3-unisoc/unbind 2>/dev/null
}
