#!/bin/sh /etc/rc.common
# Persistent lock replay is part of mobile-data radio-on: it must run after the
# nr1 handshake and before CFUN=1 while holding the radio mutex. A late replay
# here would race netifd and unnecessarily cycle an already-starting radio.
START=96
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

start_service() {
	return 0
}
