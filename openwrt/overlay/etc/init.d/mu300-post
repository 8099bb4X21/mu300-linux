#!/bin/sh /etc/rc.common
# After boot: keep mobile data up across modem resets, and mark the boot successful (re-arm slot b if Linux is default)
START=99
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

start_service() {
	# the NCM gadget interface (what a Windows host binds; macOS/Linux use ECM's usb0) joins the LAN
	# bridge at runtime - netifd would block br-lan on a configured-but-missing port
	[ -e /sys/class/net/usb1 ] && ip link set usb1 master br-lan 2>/dev/null && ip link set usb1 up
	# the host gives up asking for a DHCP lease long before this device finishes booting; if nothing took an
	# address, make the gadget re-enumerate once, which looks like a fresh cable to the host
	procd_open_instance usb-lease
	procd_set_param command /opt/mu300/bin/mu300-usb-reset --if-no-lease 25
	procd_close_instance

	procd_open_instance cellwatch
	procd_set_param command /opt/mu300/bin/mobile-data watch
	procd_set_param env MU300_NETIFD=1 PATH="$PATH"
	procd_set_param respawn 3600 30 0
	procd_close_instance
	procd_open_instance thermalguard
	procd_set_param command /opt/mu300/bin/thermal-guard
	procd_set_param env PATH="$PATH"
	procd_close_instance
	# the WCN firmware, freshly loaded, can sit for minutes with hostapd ENABLED before it
	# actually starts beaconing (measured: hot restarts beacon in ~5 s, a fresh boot in
	# 2-4 minutes, and every wifi bounce is a fresh chance). Bounce until a client
	# associates - that is the one signal that proves beacons are flowing - then stop.
	procd_open_instance wifiretry
	procd_set_param command /bin/sh -c "i=0; while [ \$i -lt 9 ]; do i=\$((i+1)); sleep 20; [ -e /sys/class/net/wlan0 ] || continue; iw dev wlan0 station dump 2>/dev/null | grep -q Station && exit 0; logger -t mu300-post AP-bounce-\$i; wifi down; sleep 2; wifi up; sleep 10; iw dev wlan0 station dump 2>/dev/null | grep -q Station && exit 0; done"
	procd_close_instance
	procd_open_instance bootok
	procd_set_param command /bin/sh -c "sleep 30; exec /opt/mu300/bin/mu300-next-boot --rearm"
	procd_set_param env PATH="$PATH"
	procd_close_instance
}
