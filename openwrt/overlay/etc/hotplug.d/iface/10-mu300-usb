# MU300: the network gadget was bound in the initramfs; macOS kept the ECM link inactive after netifd
# reconfigured usb0, and its NCM driver has not been measured to behave better. Re-enumerate the gadget
# whenever the LAN comes up, at most every 20 s, so the host starts DHCP on a fresh link.
[ "$ACTION" = ifup ] && [ "$INTERFACE" = lan ] || exit 0
stamp=/tmp/mu300-usb-rebound
now=$(cut -d. -f1 /proc/uptime)
[ -e $stamp ] && [ $((now - $(cat $stamp))) -lt 20 ] && exit 0
echo "$now" > $stamp
C=/sys/kernel/config
grep -q " $C configfs" /proc/mounts || mount -t configfs configfs $C 2>/dev/null
g=$C/usb_gadget/linux
[ -e $g/UDC ] || exit 0
udc=$(cat $g/UDC)
[ -n "$udc" ] || udc=$(ls /sys/class/udc | head -1)
(
	sleep 2
	echo "" > $g/UDC 2>/dev/null
	sleep 1
	# a single blind rebind can fail to bite (measured with the dual ECM+NCM configuration: the
	# host tears its drivers down on unbind and the gadget stays unbound forever, taking the ACM
	# console with it). Retry until UDC reports the gadget again, then restore the LAN ports.
	n=0
	while [ $n -lt 5 ]; do
		echo "$udc" > $g/UDC 2>/dev/null && grep -q . $g/UDC 2>/dev/null && [ "$(cat $g/UDC)" = "$udc" ] && break
		n=$((n + 1))
		sleep 2
	done
	if [ "$(cat $g/UDC)" = "$udc" ]; then
		logger -t mu300 "usb gadget re-enumerated on $udc"
		for u in usb0 usb1; do
			[ -e /sys/class/net/$u ] || continue
			ip link set $u up
			# usb1 exists only with a MU300_USBNET second function and is not a configured bridge
			# port: netifd would block br-lan on a missing interface, so re-attach it here as well
			[ "$u" = usb1 ] && ip link set usb1 master br-lan 2>/dev/null
		done
	else
		logger -t mu300 "usb gadget re-enumerate FAILED on $udc"
	fi
) &
