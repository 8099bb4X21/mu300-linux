#!/bin/sh
# Stop the temporary preinit DHCP server only when the real LAN is up. There is
# no timer and no UDC reset: the host keeps its lease while dnsmasq takes over.
[ "$ACTION" = ifup ] && [ "$INTERFACE" = lan ] || exit 0
pid=$(cat /run/mu300-early-udhcpd.pid 2>/dev/null)
[ -n "$pid" ] && kill "$pid" 2>/dev/null
rm -f /run/mu300-early-udhcpd.pid
# netifd has transferred usb0 to br-lan without changing the management IP or
# DHCP lease. Do not re-enumerate here: Windows already has 192.168.77.200 and
# a second UDC reset only interrupts a working Web/SSH session.
