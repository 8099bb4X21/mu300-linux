#!/bin/sh
# LED state reconciler: the event-driven LED calls can miss (boot race,
# netifd timing). Every 30 s, check WAN state and correct the LED if stale.
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"

while :; do
    sleep 30
    state=$(cat /run/led-status.state 2>/dev/null)
    wan=$(ubus call network.interface.wan status 2>/dev/null | grep -m1 '"up": true')

    if [ -n "$wan" ]; then
        # WAN is up: LED should be online-4g or online-5g, not modem/registering
        case "$state" in modem|registering|boot|offline)
            act=$(mu300-at -t 4 "AT+CEREG?" 2>/dev/null | grep '+CEREG:' | awk -F',' '{print $NF}' | tr -d '" ')
            case "$act" in
                11|12|13|15) led-status online-5g ;;
                *)           led-status online-4g ;;
            esac
        esac
    else
        # WAN is down: LED should be offline, not online
        case "$state" online-4g|online-5g)
            led-status offline
        esac
    fi
done
