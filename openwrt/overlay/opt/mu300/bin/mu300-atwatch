#!/bin/sh
# mu300-atwatch -- AT 通道看门狗。
#
# 背景（docs/FINDINGS.md 13b + 实测）：SFUN 协议栈重启或 CP 崩溃后，mu300-atd 手里的
# 描述符接在一条已死的 SIPC 通道上，永远读不到回包；atd 自带的重开逻辑非常保守
# （要 5 次无应答且 nr0 URC 静默 300 秒才动手，因为对一条活通道重开 = 彻底杀死它）。
# A live-channel close/reopen is itself destructive on this SIPC driver. The
# old watchdog killed atd after four missed probes and could turn a temporary
# busy period into a boot-long dead channel. Health is recorded only; callers
# use the already-open nr6/nr7 slot-0 pool for bounded failover.
#
# 探测本身走 mu300-at（排队、不多占通道），每通道一条 AT，15 秒一轮。

export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"

URCLOG=/run/mu300-at/urc/stty_nr0.log
FAILFILE=/run/mu300-atwatch.fails
mkdir -p /run 2>/dev/null; : > "$FAILFILE" 2>/dev/null

modem_alive() {   # nr0 有 URC 写入 = 调制解调器在说话
    [ -f "$URCLOG" ] || return 1
    [ $(( $(date +%s) - $(date -r "$URCLOG" +%s 2>/dev/null || echo 0) )) -lt 60 ]
}

fails() { sed -n "s/^$1=//p" "$FAILFILE" 2>/dev/null | tail -n1; }
setfail() { sed -i "s/^$1=.*/$1=$2/" "$FAILFILE" 2>/dev/null || echo "$1=$2" >> "$FAILFILE"; }

for d in /run/mu300-at /run/mu300-at2; do
    grep -q "^$(basename $d)=" "$FAILFILE" 2>/dev/null || echo "$(basename $d)=0" >> "$FAILFILE"
done

logger -t mu300-atwatch "monitoring $(grep -c = "$FAILFILE") primary AT channel(s), never reopening live SIPC descriptors"

while :; do
    for d in /run/mu300-at /run/mu300-at2; do
        [ -p "$d/cmd" ] || continue
        n=$(basename "$d")
        # A health probe is disposable and must never queue behind real work.
        # The next 15 s round will try again; waiting up to the client's normal
        # 90 s here used to make the watchdog itself part of an AT stampede.
        if MU300_AT_LOCK_WAIT=0 MU300_AT_DIR=$d mu300-at -t 3 "AT" >/dev/null 2>&1; then
            [ "$(fails $n)" != 0 ] && logger -t mu300-atwatch "$n answers again (was $(fails $n) fails)"
            setfail $n 0
            continue
        fi
        f=$(( $(fails $n) + 1 ))
        setfail $n $f
        if [ "$f" = 2 ]; then
            if modem_alive; then why='URCs still flow'
            else why='URCs are quiet'; fi
            logger -t mu300-atwatch "$n missed $f probes ($why); preserving its persistent descriptor"
        fi
    done
    sleep 15
done
