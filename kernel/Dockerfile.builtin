# x86_64 cross build environment for the Unisoc 5.4 kernel (LLVM=1 needs no cross binutils).
# Ubuntu 22.04 because the kernel was built with Android clang 12; 24.04 dropped clang-12.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's|archive.ubuntu.com|mirrors.tuna.tsinghua.edu.cn|g; s|security.ubuntu.com|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list \
 && apt-get update && apt-get install -y --no-install-recommends \
    clang-12 lld-12 llvm-12 build-essential bc bison flex libssl-dev libelf-dev \
    python3 python-is-python3 cpio git kmod ca-certificates rsync lz4 xz-utils file \
 && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/lib/llvm-12/bin:$PATH
WORKDIR /src
